DATABASE_URL="postgresql://postgres:password@localhost:5432/samara?schema=public"
# sandbox while testing, production when live
MPESA_ENV="sandbox"
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
# Paybill/Till number used to take payment. For Till (Buy Goods) also set MPESA_TYPE="till"
MPESA_SHORTCODE=""
MPESA_PASSKEY=""
MPESA_TYPE="paybill"
# Till only: the till number that receives money (PartyB). Leave empty for paybill.
MPESA_PARTY_B=""
# Public HTTPS address Safaricom can reach (use ngrok while developing)
CALLBACK_BASE_URL="https://your-tunnel.ngrok-free.app"
# Any long random string
MPESA_CALLBACK_SECRET=""
# Admin sign-in
ADMIN_PASSWORD=""
ADMIN_SECRET=""
